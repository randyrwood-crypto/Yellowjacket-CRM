# Copy this file to .env for local development. On Render, set these as
# Environment Variables in the dashboard instead (DATABASE_URL is filled in
# automatically when you attach a Postgres database — see README.md).

# Local Postgres connection string. Render provides its own automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yjcrm

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# development | production. Render sets this to production automatically.
NODE_ENV=development

PORT=3000
